      "parameters": {
        "jsCode": "const postalCodes = ['18005', '18014', '18002', '18006', '18007', '18004', '18003', '18001'];\nconst companies = [\n  { name: 'Endesa', url: 'https://www.endesa.com/es/tarifas', web: 'https://www.endesa.es', logo: 'https://www.endesa.com/etc/designs/endesa-www/clientlibs/img/logo-endesa.svg' },\n  { name: 'Iberdrola', url: 'https://www.iberdrola.es/tarifas', web: 'https://www.iberdrola.es', logo: 'https://www.iberdrola.es/wcorp/assets/Inicio/Logo-Iberdrola.png' },\n  { name: 'Naturgy', url: 'https://www.naturgy.es/hogar/luz', web: 'https://www.naturgy.es', logo: 'https://www.naturgy.es/etc/designs/naturgy-www/en_US/clientlibs/assets/logos/naturgy-logo.svg' },\n  { name: 'Digi', url: 'https://www.digimobil.es/fibra-optica', web: 'https://www.digimobil.es', logo: 'https://www.digimobil.es/assets/images/logo-digi.png' },\n  { name: 'Movistar', url: 'https://www.movistar.es/particulares/tarifas', web: 'https://www.movistar.es', logo: 'https://www.movistar.es/static/images/movistar-logo.svg' },\n  { name: 'Orange', url: 'https://www.orange.es/tarifas', web: 'https://www.orange.es', logo: 'https://www.orange.es/static/images/header/logo-orange.svg' }\n];\n\nconst items = [];\nfor (const cp of postalCodes) {\n  for (const company of companies) {\n    items.push({\n      json: {\n        codigoPostal: cp,\n        company: company.name,\n        targetUrl: company.url,\n        proveedorWeb: company.web,\n        proveedorLogo: company.logo\n      }\n    });\n  }\n}\nreturn items;"
      },
